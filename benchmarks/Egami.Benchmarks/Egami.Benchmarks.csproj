<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The VP8 stage timers (src/Egami/Formats/Webp/Vp8StageTimes.cs), for the stage profile (Vp8Timing.RunStages); build with -p:Vp8StageTimers=true. -->
  <PropertyGroup Condition="'$(Vp8StageTimers)' == 'true'">
    <DefineConstants>$(DefineConstants);VP8_STAGE_TIMERS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Egami\Egami.csproj" />
    <ProjectReference Include="..\..\src\Egami.Barcodes\Egami.Barcodes.csproj" />
    <ProjectReference Include="..\..\src\Egami.Formats.Extended\Egami.Formats.Extended.csproj" />
    <!-- Builds interlaced PNGs independently of Egami's writer, which writes only non-interlaced files. -->
    <Compile Include="..\..\tests\Egami.Tests\Formats\Png\PngBuilder.cs" Link="PngBuilder.cs" />
    <!-- The Phase 2.2 peak-memory harness, shared with the tests. -->
    <Compile Include="..\..\tests\Egami.Tests\Memory\PeakMemory.cs" Link="PeakMemory.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

</Project>
