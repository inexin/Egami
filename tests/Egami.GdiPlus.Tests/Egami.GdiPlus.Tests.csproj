<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Egami.Drawing.Path" Alias="Path" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Egami\Egami.csproj" />
    <ProjectReference Include="..\..\src\Egami.Drawing\Egami.Drawing.csproj" />
  </ItemGroup>

  <!-- The shared GDI+ code is internal source compiled into each package that uses it, so its tests compile it too, apart from
       either package. -->
  <ItemGroup>
    <Compile Include="..\..\src\Shared\GdiPlus\**\*.cs" Link="Shared\GdiPlus\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
