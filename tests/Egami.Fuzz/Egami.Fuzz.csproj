<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fuzzing harness for SharpFuzz with AFL++. See README.md in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Egami\Egami.csproj" />
    <ProjectReference Include="..\..\src\Egami.Fonts\Egami.Fonts.csproj" />
    <ProjectReference Include="..\..\src\Egami.Drawing\Egami.Drawing.csproj" />
    <ProjectReference Include="..\..\src\Egami.Css\Egami.Css.csproj" />
    <ProjectReference Include="..\..\src\Egami.Svg\Egami.Svg.csproj" />
    <ProjectReference Include="..\..\src\Egami.Metafiles\Egami.Metafiles.csproj" />
    <ProjectReference Include="..\..\src\Egami.Heic\Egami.Heic.csproj" />
    <ProjectReference Include="..\..\src\Egami.Barcodes\Egami.Barcodes.csproj" />
    <ProjectReference Include="..\..\src\Egami.Cli\Egami.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bidi target's one font: Noto Sans Arabic (OFL) cut to its Latin and Arabic glyphs with their layout closure. -->
    <EmbeddedResource Include="NotoSansArabic-subset.ttf" LogicalName="NotoSansArabic-subset.ttf" />
    <!-- The paragraph target's second font: tests/fonts' Chinese, Japanese and Korean layout subset (fuzz-afl.py copies it in). -->
    <EmbeddedResource Include="..\fonts\derived\NotoSansCJK-layout-subset.otf" LogicalName="NotoSansCJK-layout-subset.otf" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Egami.Cli.Hosting" />
    <Using Include="Egami.Cli.Hosting.Mcp" />
  </ItemGroup>

</Project>
