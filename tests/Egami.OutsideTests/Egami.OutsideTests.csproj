<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything here uses only Egami's public API, as an outside package would: no InternalsVisibleTo. It proves that a pixel type,
    a memory source, an operation, wrapped strided memory, a single-frame format and an animated format can live outside Egami.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Egami\Egami.csproj" />
  </ItemGroup>

</Project>
