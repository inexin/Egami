<Project Sdk="Microsoft.NET.Sdk">

  <!-- Published with Native AOT in CI. Rooting all of Egami makes the trim and AOT analyzers check every public and internal code path. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Egami\Egami.csproj" />
    <TrimmerRootAssembly Include="Egami" />
  </ItemGroup>

</Project>
