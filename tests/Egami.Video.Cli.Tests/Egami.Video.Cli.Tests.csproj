    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Egami.Cli.Hosting" />
    <Using Include="Egami.Video.Containers" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../video/corpus/**/*" LinkBase="corpus" CopyToOutputDirectory="PreserveNewest" />
