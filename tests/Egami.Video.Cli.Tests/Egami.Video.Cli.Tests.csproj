    <None Include="ffmpeg-edit-lines.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Egami.Video.Cli\Egami.Video.Cli.csproj" />
    <!-- Built for the test of 'egami video', which runs egami-video from the egami tool. -->
    <ProjectReference Include="..\..\src\Egami.Cli\Egami.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

