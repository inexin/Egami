<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Lars Dytterud</Authors>
    <Copyright>Copyright (c) 2026 Lars Dytterud</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://inexin.github.io/Egami/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/inexin/Egami</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Tags every package shares; each package adds its own in its project file. -->
    <EgamiPackageTags>egami;imaging;graphics;managed;dotnet</EgamiPackageTags>
    <!-- The shared version of the Egami release train: Egami, Egami.Drawing, Egami.Fonts, Egami.Svg, Egami.Css, Egami.Heic,
         Egami.Formats.Extended, Egami.Cli and Egami.Cli.Host. They release together on the tag v<version>. Egami.Heic depends on
         exactly this version of Egami. The other packages (Barcodes, Metafiles, Fonts.Substitutes, Video) set their own version in their project file. -->
    <EgamiVersion>1.3.1</EgamiVersion>
    <!-- Egami.Video's own version, which Egami.Video.Cli (egami-video) carries too (Video CLI design Q1). -->
    <EgamiVideoVersion>1.0.0</EgamiVideoVersion>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
