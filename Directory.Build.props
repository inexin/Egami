<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Lars Dytterud</Authors>
    <Copyright>Copyright (c) 2026 Lars Dytterud</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://inexin.github.io/Egami/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/inexin/Egami</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Tags every package shares; each package adds its own in its project file. -->
    <EgamiPackageTags>egami;imaging;graphics;managed;dotnet</EgamiPackageTags>
    <!-- Core Egami's version. Egami.Heic ships at the same version and depends on exactly it (2.9.4 design, question 8). -->
    <EgamiVersion>1.1.0</EgamiVersion>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
