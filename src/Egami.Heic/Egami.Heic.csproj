<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egami.Heic</RootNamespace>
    <PackageId>Egami.Heic</PackageId>
    <!-- Egami.Heic ships with every Egami release, at Egami's version, and depends on exactly that version (2.9.4 design,
         question 8): it uses core Egami's internal HEIF code. -->
    <Version>$(EgamiVersion)</Version>
    <Description>HEIC for Egami: reads and writes HEIF files with HEVC-coded images, such as iPhone and Android photos, in managed code. HEVC is covered by patents, encoding as well as decoding; Egami's authors grant no patent rights and are not lawyers. Whether you need a patent licence depends on your country and on how you use and distribute this package; commercial products may need one from the HEVC patent pools or holders. The core Egami package contains no HEVC code and does not depend on this package.</Description>
    <PackageTags>$(EgamiPackageTags);heic;heif;hevc;h265</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- For [SkipLocalsInit] on the decoder's hot paths: their scratch stackallocs are written before they are read. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Egami\Egami.csproj" />
  </ItemGroup>

  <!-- The NAL code Egami.Heic shares with Egami.Video.H264, compiled into each as internal source (H.264 and HEVC design, Q1). -->
  <ItemGroup>
    <Compile Include="..\Shared\Nal\**\*.cs" Link="Shared\Nal\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egami.Heic.Tests" />
    <InternalsVisibleTo Include="Egami.Fuzz" />
    <InternalsVisibleTo Include="Egami.Video.Hevc.Tests" />
  </ItemGroup>

  <!-- The package depends on exactly the Egami it was built with: [1.3.1], not 1.3.1 or later. -->
  <Target Name="PinEgamiVersion" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
