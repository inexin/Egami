<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egami.Formats.Extended</RootNamespace>
    <PackageId>Egami.Formats.Extended</PackageId>
    <!-- Egami.Formats.Extended rides the Egami release train at Egami's version (Egami.Formats.Extended design, question 2). It
         uses only core Egami's public plugin API (question 9), so it depends on that version or later. -->
    <Version>$(EgamiVersion)</Version>
    <Description>Extra image formats for Egami, as plugins: PCX, SGI, Sun raster, XBM, XPM, WBMP, Farbfeld, JPEG-LS, DDS textures and DPX and Cineon film frames, read and written in managed code, KTX and KTX 2 textures read, camera RAW (DNG) developed on load, and, as a preview, the DICOM dataset. Register them all with WithExtendedFormats(), or one at a time.</Description>
    <PackageTags>$(EgamiPackageTags);pcx;sgi;sun-raster;xbm;xpm;wbmp;farbfeld;jpeg-ls;jls;dicom;dds;ktx;ktx2;texture;bc7;dpx;cineon;film;raw;dng;camera-raw;medical-imaging</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The package uses its own preview API (DICOM, decision Q13). -->
    <NoWarn>$(NoWarn);EGAMIX001</NoWarn>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Egami\Egami.csproj" />
  </ItemGroup>

  <!-- The camera colour table (RAW decision Q6), generated by tools/make-raw-camera-table.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Raw\RawCameras.txt" LogicalName="Egami.Formats.Extended.Raw.RawCameras.txt" />
  </ItemGroup>

  <!-- PS3.6's data dictionary and UID registry (DICOM decision Q6), generated by tools/make-dicom-dictionary.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Dicom\DicomDictionary.txt" LogicalName="Egami.Formats.Extended.Dicom.DicomDictionary.txt" />
    <EmbeddedResource Include="Dicom\DicomUids.txt" LogicalName="Egami.Formats.Extended.Dicom.DicomUids.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egami.Formats.Extended.Tests" />
    <InternalsVisibleTo Include="Egami.Fuzz" />
    <InternalsVisibleTo Include="Egami.Benchmarks" />
  </ItemGroup>

</Project>
