<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egami.Metafiles</RootNamespace>
    <PackageId>Egami.Metafiles</PackageId>
    <Version>1.0.1</Version>
    <!-- 1.0 froze the API (PublicAPI.Shipped.txt). Later 1.x versions set PackageValidationBaselineVersion to 1.0.0 once that
         package is on a feed the build can reach, so package validation also checks binary compatibility with it. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>Windows metafiles for Egami: plays WMF, EMF and EMF+ pictures onto Egami.Drawing's canvas, so they stay vectors in PDF and SVG output and rasterize on any OS, in managed code.</Description>
    <PackageTags>$(EgamiPackageTags);wmf;emf;emf-plus;metafile</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Public API of the packages below only (2.3.7 design, question 2). -->
  <ItemGroup>
    <ProjectReference Include="..\Egami\Egami.csproj" />
    <ProjectReference Include="..\Egami.Drawing\Egami.Drawing.csproj" />
    <ProjectReference Include="..\Egami.Fonts\Egami.Fonts.csproj" />
  </ItemGroup>

  <!-- The GDI+ pen, brush, region, string format and image attribute semantics, shared with Egami.SystemDrawing as internal
       source (step 2.13, question 7). -->
  <ItemGroup>
    <Compile Include="..\Shared\GdiPlus\**\*.cs" Link="Shared\GdiPlus\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egami.Metafiles.Tests" />
    <InternalsVisibleTo Include="Egami.Fuzz" />
  </ItemGroup>

</Project>
