<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egami.Video</RootNamespace>
    <PackageId>Egami.Video.Hevc</PackageId>
    <!-- Egami.Video.Hevc ships at Egami.Video's version (H.264 and HEVC design, question 4) and wraps Egami.Heic's public
         HevcStreamDecoder (V8 design): HEVC video users get HEIC photos too, the same patent family. -->
    <Version>$(EgamiVideoVersion)</Version>
    <Description>HEVC (H.265) decoding for Egami.Video, in managed code: Main, Main 10, Main 12 and the format range extensions to 12 bits, in MP4, MOV, Matroska and raw .h265 files, through Egami.Heic's HEVC decoder. HEVC is covered by patents; Egami's authors grant no patent rights and are not lawyers. Whether you need a patent licence depends on your country and on how you use and distribute this package; commercial products may need one from the HEVC patent pools or holders. Egami.Video itself contains no HEVC decoder and does not depend on this package.</Description>
    <PackageTags>$(EgamiPackageTags);video;hevc;h265;mp4</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- SkipLocalsInit in the linked HEVC encoder files. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Egami.Video\Egami.Video.csproj" />
  </ItemGroup>

  <!-- Packed against the released Egami.Heic (UseReleasedDependencies=true), as Egami.Video is against the released Egami. -->
  <ItemGroup Condition="'$(UseReleasedDependencies)' != 'true'">
    <ProjectReference Include="..\Egami.Heic\Egami.Heic.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseReleasedDependencies)' == 'true'">
    <PackageReference Include="Egami.Heic" VersionOverride="1.4.0" />
  </ItemGroup>

  <!-- The shared NAL code and Egami.Heic's HEVC coding layer, compiled in as internal source (H.264 and HEVC design, Q1; HEVC
       encoder design, Q1). The raw .h265 reader takes the track's size, colour and frame rate from the stream's SPS before any
       decoding, and the encoder builds on the HEIC encoder's intra search, syntax and parameter set writers, transforms, loop
       filters and inter prediction. Linked rather than referenced, so a Video release never waits for an Egami.Heic release.
       Egami.Heic's decoders and its HEIF glue (HevcCodec) are left out: decoding goes through the public HevcStreamDecoder. -->
  <ItemGroup>
    <Compile Include="..\Shared\Nal\**\*.cs" Link="Shared\Nal\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Egami.Heic\Hevc\*.cs" Exclude="..\Egami.Heic\Hevc\HevcCodec.cs;..\Egami.Heic\Hevc\HevcDecoder.cs;..\Egami.Heic\Hevc\HevcSequenceDecoder.cs" Link="Heic\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egami.Video.Hevc.Tests" />
    <InternalsVisibleTo Include="Egami.Video.Benchmarks" />
    <InternalsVisibleTo Include="Egami.Video.Fuzz" />
  </ItemGroup>

</Project>
