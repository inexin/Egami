<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egami.Video</RootNamespace>
    <PackageId>Egami.Video</PackageId>
    <Version>$(EgamiVideoVersion)</Version>
    <Description>A fully managed, MIT-licensed video and audio library for .NET built on Egami: frames, packets and samples; MP4, Matroska/WebM, AVI, Ogg, IVF, WAV, FLAC, MP3, AIFF and CAF files; AV1, VP9 and VP8 decode and encode, Motion JPEG, Opus, Vorbis, FLAC, MP3, AC-3, AAC LC and ALAC; subtitles, smart cut and scene detection.</Description>
    <PackageTags>$(EgamiPackageTags);video;audio;mp4;webm;matroska;vp8;vp9;av1;opus;mp3;flac;aac</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- For [SkipLocalsInit] on the codecs' hot paths: their scratch stackallocs are written before they are read. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Packed against the released Egami (UseReleasedDependencies=true, which release.yml packs with and ci.yml checks), so a
    stable Egami.Video installs with what is on nuget.org while main's Egami is a preview; day to day it builds against the
    project.
  -->
  <ItemGroup Condition="'$(UseReleasedDependencies)' != 'true'">
    <ProjectReference Include="..\Egami\Egami.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseReleasedDependencies)' == 'true'">
    <PackageReference Include="Egami" VersionOverride="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egami.Video.Tests" />
    <InternalsVisibleTo Include="Egami.Video.Benchmarks" />
    <InternalsVisibleTo Include="Egami.Video.Fuzz" />
    <!-- The H.264 encoder runs on the encoder core (H.264 Encoder Design, Q2); the two ship on one version. -->
    <InternalsVisibleTo Include="Egami.Video.H264" />
    <!-- So does the HEVC encoder (HEVC encoder design, Q1). -->
    <InternalsVisibleTo Include="Egami.Video.Hevc" />
  </ItemGroup>

</Project>
