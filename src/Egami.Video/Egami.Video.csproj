<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egami.Video</RootNamespace>
    <PackageId>Egami.Video</PackageId>
    <Version>$(EgamiVideoVersion)</Version>
    <Description>A fully managed, MIT-licensed video and audio library for .NET built on Egami: frames, packets and samples; MP4, Matroska/WebM, AVI, Ogg, IVF, WAV, FLAC, MP3, AIFF and CAF files; AV1, VP9 and VP8 decode and encode, Motion JPEG, Opus, Vorbis, FLAC, MP3, AC-3 and ALAC; subtitles, smart cut and scene detection.</Description>
    <PackageTags>$(EgamiPackageTags);video;audio;mp4;webm;matroska;vp8;vp9;av1;opus;mp3;flac</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- For [SkipLocalsInit] on the codecs' hot paths: their scratch stackallocs are written before they are read. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Egami\Egami.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egami.Video.Tests" />
    <InternalsVisibleTo Include="Egami.Video.Benchmarks" />
    <InternalsVisibleTo Include="Egami.Video.Fuzz" />
  </ItemGroup>

</Project>
