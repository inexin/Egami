<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egami.Drawing</RootNamespace>
    <PackageId>Egami.Drawing</PackageId>
    <Version>1.0.1</Version>
    <!-- 1.0 froze the API (PublicAPI.Shipped.txt). Later 1.x versions set PackageValidationBaselineVersion to 1.0.0 once that
         package is on a feed the build can reach, so package validation also checks binary compatibility with it. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>Antialiased paths, shapes, strokes, clips, images, paints, layers, meshes and recorded drawings on a canvas for Egami, with backends beyond the raster.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Egami's public API only: no InternalsVisibleTo from the core (2.6.1 question 1). -->
  <ItemGroup>
    <ProjectReference Include="..\Egami\Egami.csproj" />
    <ProjectReference Include="..\Egami.Fonts\Egami.Fonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egami.Drawing.Tests" />
    <InternalsVisibleTo Include="Egami.Drawing.Benchmarks" />
  </ItemGroup>

</Project>
