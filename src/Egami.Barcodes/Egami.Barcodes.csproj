<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egami.Barcodes</RootNamespace>
    <PackageId>Egami.Barcodes</PackageId>
    <!-- Unreleased: the package ships once, as 1.0.0, when its API is complete (2.11 design, question 17). -->
    <Version>1.0.0</Version>
    <Description>Barcodes for Egami: writes and reads 1D and 2D barcodes, drawn onto Egami.Drawing's canvas or read from rasters, in managed code.</Description>
    <PackageTags>$(EgamiPackageTags);barcode;qr-code;data-matrix</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- A caller's luminance buffer is pinned and read in place (BarcodeReader). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Public API of the packages below only (2.11 design, question 2). -->
  <ItemGroup>
    <ProjectReference Include="..\Egami\Egami.csproj" />
    <ProjectReference Include="..\Egami.Drawing\Egami.Drawing.csproj" />
    <ProjectReference Include="..\Egami.Fonts\Egami.Fonts.csproj" />
  </ItemGroup>

  <!-- The GS1 Barcode Syntax Dictionary (Apache-2.0), as GS1 publishes it; see THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <EmbeddedResource Include="Gs1Data\gs1-syntax-dictionary.txt" LogicalName="Egami.Barcodes.gs1-syntax-dictionary.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egami.Barcodes.Tests" />
    <InternalsVisibleTo Include="Egami.Fuzz" />
  </ItemGroup>

</Project>
