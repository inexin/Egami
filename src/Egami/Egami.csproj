<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egami</RootNamespace>
    <PackageId>Egami</PackageId>
    <Description>A fully managed, MIT-licensed 2D imaging library for .NET.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Needed for unmanaged pixel memory (Memory/UnmanagedBlock.cs). Other unsafe code needs a benchmark showing the gain. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The Phase 2.4.5 VP8 stage timers (Formats/Webp/Vp8StageTimes.cs), for the stage profile in benchmarks/Egami.Benchmarks only:
       build with -p:Vp8StageTimers=true. Never set for a shipped build. -->
  <PropertyGroup Condition="'$(Vp8StageTimers)' == 'true'">
    <DefineConstants>$(DefineConstants);VP8_STAGE_TIMERS</DefineConstants>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. The only package reference allowed in src/ (checked in ci.yml). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- ColorProfile.Fogra39: the CTAN colorprofiles copy, unchanged (see THIRD-PARTY-NOTICES.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Colors/Profiles/FOGRA39L_coated.icc" LogicalName="Egami.Colors.FOGRA39L_coated.icc" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egami.Tests" />
    <InternalsVisibleTo Include="Egami.Benchmarks" />
    <InternalsVisibleTo Include="Egami.Fuzz" />
  </ItemGroup>

</Project>
