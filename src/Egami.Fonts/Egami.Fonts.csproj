<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Egami.Fonts</RootNamespace>
    <PackageId>Egami.Fonts</PackageId>
    <Version>$(EgamiVersion)</Version>
    <!-- 1.0 froze the API (PublicAPI.Shipped.txt). Later 1.x versions set PackageValidationBaselineVersion to 1.0.0 once that
         package is on a feed the build can reach, so package validation also checks binary compatibility with it. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>TrueType and OpenType (CFF) fonts for Egami: faces, glyph outlines, metrics, kerning, installed fonts and subsetting, in managed code.</Description>
    <PackageTags>$(EgamiPackageTags);fonts;opentype;truetype;woff;text-shaping;text-layout</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Build-time analyzer only; ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Egami's public API only: no InternalsVisibleTo from the core (2.7.1 question 1). -->
  <ItemGroup>
    <ProjectReference Include="..\Egami\Egami.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Egami.Fonts.Tests" />
    <InternalsVisibleTo Include="Egami.Fonts.Benchmarks" />
    <InternalsVisibleTo Include="Egami.Drawing" />
    <InternalsVisibleTo Include="Egami.Fuzz" />
  </ItemGroup>

</Project>
