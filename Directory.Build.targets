<Project>
  <!-- Each package's NuGet icon is branding/nuget/<PackageId>.png. Projects without one (tests, samples) pack no icon. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)branding/nuget/$(PackageId).png')">
    <PackageIcon>$(PackageId).png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(PackageIcon)' != ''">
    <None Include="$(MSBuildThisFileDirectory)branding/nuget/$(PackageIcon)" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Each package's NuGet readme is the README.md in its project folder. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(PackageReadmeFile)' != ''">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Each package's guide for coding agents is docs/agents/<PackageId>.md, packed as AGENTS.md next to the readme.
       tools/make-llms-txt.py writes it from tools/agent-guides/<PackageId>.md. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)docs/agents/$(PackageId).md')">
    <None Include="$(MSBuildThisFileDirectory)docs/agents/$(PackageId).md" Pack="true" PackagePath="AGENTS.md" Visible="false" />
  </ItemGroup>

  <!-- Every package carries THIRD-PARTY-NOTICES.md: the notices of the third-party tables, data and code Egami uses, which
       their licences ask to travel with copies. The package licence itself is the MIT expression in Directory.Build.props. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
