{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Egami",
          "files": [ "Egami.csproj" ]
        },
        {
          "src": "../src/Egami.Drawing",
          "files": [ "Egami.Drawing.csproj" ]
        },
        {
          "src": "../src/Egami.Fonts",
          "files": [ "Egami.Fonts.csproj" ]
        },
        {
          "src": "../src/Egami.Fonts.Substitutes",
          "files": [ "Egami.Fonts.Substitutes.csproj" ]
        },
        {
          "src": "../src/Egami.Svg",
          "files": [ "Egami.Svg.csproj" ]
        },
        {
          "src": "../src/Egami.Css",
          "files": [ "Egami.Css.csproj" ]
        },
        {
          "src": "../src/Egami.Metafiles",
          "files": [ "Egami.Metafiles.csproj" ]
        },
        {
          "src": "../src/Egami.Barcodes",
          "files": [ "Egami.Barcodes.csproj" ]
        },
        {
          "src": "../src/Egami.Heic",
          "files": [ "Egami.Heic.csproj" ]
        }
      ],
      "dest": "api",
      "properties": { "TargetFramework": "net10.0" }
    }
  ],
  "build": {
    "content": [
      { "files": [ "index.md", "toc.yml", "articles/**/*.md", "articles/**/toc.yml", "api/**.yml", "api/index.md" ] }
    ],
    "resource": [
      { "files": [ "images/**", "llms.txt" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern", "template" ],
    "globalMetadata": {
      "_appName": "Egami",
      "_appTitle": "Egami",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.ico",
      "_enableSearch": true
    }
  }
}
